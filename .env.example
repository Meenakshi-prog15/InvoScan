# ─── FREE Vision LLM API Keys (No Credit Card Needed) ────────────────────────
# Google AI Studio — https://aistudio.google.com/apikey (FREE)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Console — https://console.groq.com (FREE)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — https://openrouter.ai/keys (FREE vision models available)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA Build API — https://build.nvidia.com/ (FREE prototype credits may apply)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ─── Paid / Trial Credit Models ──────────────────────────────────────────────
# Anthropic Console — https://console.anthropic.com/settings/keys ($5 free trial)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Platform — https://platform.openai.com/api-keys ($5 free trial)
OPENAI_API_KEY=your_openai_api_key_here

# ─── Zoho Books OAuth2 ───────────────────────────────────────────────────────
# Create a Server-Based Application at https://api-console.zoho.in/
# Scopes needed: ZohoBooks.expenses.CREATE, ZohoBooks.expenses.READ
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_org_id

# Zoho datacenter: "in" for India (books.zoho.in), "com" for global (books.zoho.com)
ZOHO_DATACENTER=in

# ─── Server Config ───────────────────────────────────────────────────────────
PORT=3001
